# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/motionmesh?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# NATS JetStream
QUEUE_URL=nats://localhost:4222

# Object Storage (Backblaze B2 — same vars in every environment, different values)
# Use a bucket scoped to dev; never point local dev at the production bucket.
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET=motionmesh-production
STORAGE_REGION=us-east-005
STORAGE_USE_SSL=true

# Auth — JWT signing secret (generate with: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret

# Clerk (dashboard auth)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# JWKS endpoint for networkless JWT verification (from Clerk dashboard → API Keys)
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json


# Stripe
STRIPE_SECRET_KEY=sk_test_REDACTED
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
